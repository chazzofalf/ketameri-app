<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sk="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="Symbs.BorderView"
             Padding="-11">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <sk:SKCanvasView x:Name="Top"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="11" PaintSurface="Top_PaintSurface" />
           
        
        <sk:SKCanvasView x:Name="Bottom" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" HeightRequest="11" PaintSurface="Bottom_PaintSurface" />
        <sk:SKCanvasView x:Name="Left" Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" WidthRequest="11" PaintSurface="Left_PaintSurface"/>
        <sk:SKCanvasView x:Name="Right" Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" WidthRequest="11" PaintSurface="Right_PaintSurface" />
    </Grid>
</ContentView>
