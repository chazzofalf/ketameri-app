<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Symbs.TextViewer"
             >
             <Grid  x:Name="TextViewTab" > 
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ScrollView x:Name="Scroll" Grid.Column="0" Grid.Row="1" Orientation="Vertical">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Editor Grid.Row="0" Grid.Column="0" x:Name="TextEditor" TextColor="Turquoise" TextChanged="TextEditor_TextChanged" AutoSize="TextChanges"/>
                        <Grid x:Name="WinSpacer" Grid.Column="0" Grid.Row="1"  IsVisible="Collapse" HeightRequest="72"/>
                    </Grid>
                    
                    
                </ScrollView>
                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SaveButton" Text="Save" Grid.Row="0" Grid.Column="0" Clicked="SaveButton_Clicked"/>
                    <Button x:Name="LoadButton" Text="Load" Grid.Row="0" Grid.Column="1" Clicked="LoadButton_Clicked"/>
                    <Button x:Name="NewButton" Text="New" Grid.Row="0" Grid.Column="2" Clicked="NewButton_Clicked"/>
                    
                </Grid>
            <ActivityIndicator x:Name="Loader" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Grid.RowSpan="2" IsRunning="False" IsVisible="False" Color="Turquoise" />
            </Grid>
</ContentView>