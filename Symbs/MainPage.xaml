<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Symbs.MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ScrollView Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="0" HeightRequest="16" Grid.Column="0" Grid.ColumnSpan="3"/>                
                <Grid Grid.Row="2" HeightRequest="16" Grid.Column="0" Grid.ColumnSpan="3"/>
                <Button Grid.Row="1" Text="Text" Grid.Column="0" x:Name="ShowTextViewButton" Clicked="ShowTextViewButton_Clicked" />
                <Button Grid.Row="1" Text="Background" Grid.Column="1" x:Name="ShowImageViewButton" Clicked="ShowImageViewButton_Clicked" BackgroundColor="{StaticResource PrimaryDarkInactive}" TextColor="{StaticResource PrimaryDarkTextInactive}"/>
                <Button Grid.Row="1" Text="Results" Grid.Column="2" x:Name="ShowResultsViewButton" Clicked="ShowResultsViewButton_Clicked" BackgroundColor="{StaticResource PrimaryDarkInactive}" TextColor="{StaticResource PrimaryDarkTextInactive}"/>

            </Grid>
        </ScrollView>
    </Grid>

</ContentPage>
