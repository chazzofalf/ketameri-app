<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Symbs.MainPage"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:local="clr-namespace:Symbs"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ScrollView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Grid ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- <ColumnDefinition Width="Auto"/> -->
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="0" HeightRequest="16" Grid.Column="0" Grid.ColumnSpan="3"/>                
                <Grid Grid.Row="2" HeightRequest="16" Grid.Column="0" Grid.ColumnSpan="3"/>
                <Button Grid.Row="1" Text="Text" Grid.Column="0" x:Name="ShowTextViewButton" Clicked="ShowTextViewButton_Clicked" />
                <!-- <Button Grid.Row="1" Text="Background" Grid.Column="1" x:Name="ShowImageViewButton" Clicked="ShowImageViewButton_Clicked" BackgroundColor="{StaticResource PrimaryDarkInactive}" TextColor="{StaticResource PrimaryDarkTextInactive}"/> -->
                <Button Grid.Row="1" Text="Results" Grid.Column="1" x:Name="ShowResultsViewButton" Clicked="ShowResultsViewButton_Clicked" BackgroundColor="{StaticResource PrimaryDarkInactive}" TextColor="{StaticResource PrimaryDarkTextInactive}"/>
                <Button Grid.Row="1" Text="About" Grid.Column="2" x:Name="ShowAboutViewButton" Clicked="ShowAboutViewButton_Clicked" BackgroundColor="{StaticResource PrimaryDarkInactive}" TextColor="{StaticResource PrimaryDarkTextInactive}"/>
                <Button Grid.Row="1" Text="Alphabet" Grid.Column="3" x:Name="ShowAlphabetViewButton" Clicked="ShowAlphabetViewButton_Clicked" BackgroundColor="{StaticResource PrimaryDarkInactive}" TextColor="{StaticResource PrimaryDarkTextInactive}"/>


            
            </Grid>
        </ScrollView>
        <local:TextViewer Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TextViewTab"/>
        
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ImageViewTab" IsVisible="False" BackgroundColor="White"/>
        <local:ImageViewer  Grid.Row="0" Grid.Column="0" x:Name="ResultsViewTab" IsVisible="False"/>
        
        <local:AboutView Grid.Row="0"  Grid.Column="0" Grid.ColumnSpan="2" x:Name="AboutViewTab" IsVisible="False"/>
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" x:Name="AlphabetViewTab" IsVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    
                <RowDefinition Height="Auto"/>            
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollView Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <skia:SKCanvasView HeightRequest="54" BackgroundColor="Black" x:Name="AlphabetGraphic" PaintSurface="AlphabetGraphic_PaintSurface" SizeChanged="AlphabetGraphic_SizeChanged"></skia:SKCanvasView>
                </Grid>
                
            </ScrollView>
            <Button Text="Save Graphic" x:Name="SaveAlphabet" Clicked="SaveAlphabet_Clicked" Grid.Column="0" Grid.Row="1"/>
        </Grid>
        <ActivityIndicator x:Name="Loader" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2" IsRunning="False" IsVisible="True" Color="Turquoise" BackgroundColor="Black"/>
    </Grid>

</ContentPage>
