<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Symbs.ImageViewer"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls">
    
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>                
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollView Grid.Row="1" Grid.Column="0" Orientation="Both">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <skia:SKCanvasView Grid.Row="0" Grid.Column="0" HeightRequest="54" WidthRequest="54" PaintSurface="SKCanvasView_PaintSurface" SizeChanged="SKCanvasView_SizeChanged" x:Name="ImageViewerViewer" BackgroundColor="Black"/>
                </Grid>
            </ScrollView>
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="0" x:Name="Load" Text="Load" Clicked="Load_Clicked"/>
                <Button Grid.Row="0" Grid.Column="1" x:Name="Save" Text="Save" Clicked="Save_Clicked"/>
            </Grid>
        <ActivityIndicator x:Name="Loader" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Grid.RowSpan="2" IsRunning="False" IsVisible="False" Color="Turquoise" />
        </Grid>        
    
</ContentView>
