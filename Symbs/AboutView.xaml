<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Symbs.AboutView"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls">
    <Grid   BackgroundColor="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ScrollView Grid.Row="0" Grid.Column="0" Orientation="Vertical">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <skia:SKCanvasView Grid.Column="0" Grid.Row="0" HeightRequest="54"  BackgroundColor="Black" x:Name="AboutGraphic" PaintSurface="AboutGraphic_PaintSurface" SizeChanged="AboutGraphic_SizeChanged"></skia:SKCanvasView>
                <ActivityIndicator x:Name="WindowsSpacer" Grid.Row="1" Grid.Column="0" IsVisible="Collapse" BackgroundColor="Black" HeightRequest="108"/>
            </Grid>
        </ScrollView>
        <ActivityIndicator x:Name="Loader" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Grid.RowSpan="1" IsRunning="False" IsVisible="False" Color="Turquoise" BackgroundColor="Black"/>
        
    </Grid>
</ContentView>
